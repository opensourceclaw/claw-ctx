#!/bin/sh
# claw-ctx stage-gate pre-push hook (v6.10.3+)
#
# Enforces at process level what the protocol enforces by convention:
#   - push to refs/heads/main: requires a PASS TEST acceptance receipt in
#     inbox/inbox-results/ AND a Peter APPROVED release record in
#     inbox/inbox-plan/ or inbox/inbox-release/ (artifact separation — one
#     file may not satisfy both), each dated no earlier than the batch:
#     oldest commit in remote..local, or — on first push (remote = ZERO) —
#     the oldest commit of the local branch.
#   - push of refs/tags/v*: requires gates.json release-approval-gate with
#     status=passed and metadata.version matching the tag.
#   - emergency bypass: OPENCLAW_GATE_BYPASS=<sig> must hit a valid
#     emergency-bypass record in gates.json; that env channel is appended to
#     inbox/govern/bypass-log.md.
#
# KNOWN BOUNDARY (client-side ceiling, by git design): this hook only runs
# on a cooperating client — `git push --no-verify` skips it silently with no
# local trace. Server-side defenses are the backstop: GitHub branch
# protection on main + tag ruleset (see
# docs/audits/stage-gate-defense-in-depth.md for the current audit posture).
#
# POSIX sh (macOS bash3 compatible). No external dependencies.
# FAIL-CLOSED: any unreadable prerequisite rejects the push.

set -u

GATES_FILE="${OPENCLAW_GATES_FILE:-$HOME/.openclaw/gates/gates.json}"
BYPASS_SIG="${OPENCLAW_GATE_BYPASS:-}"
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
RESULTS_DIR="$ROOT/inbox/inbox-results"
BYPASS_LOG="$ROOT/inbox/govern/bypass-log.md"

is_zero_sha() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

mtime_of() {
  m=$(stat -f %m "$1" 2>/dev/null) || m=$(stat -c %Y "$1" 2>/dev/null) || m=0
  echo "${m:-0}"
}

log_bypass() {
  mkdir -p "$(dirname "$BYPASS_LOG")" 2>/dev/null
  ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  printf -- '- %s | bypass | ref=%s local=%s | sig=%s\n' \
    "$ts" "$1" "$2" "$BYPASS_SIG" >> "$BYPASS_LOG" 2>/dev/null || true
}

# sig must hit a gateId or authorization value of an emergency-bypass record
bypass_is_valid() {
  [ -r "$GATES_FILE" ] || return 1
  ids=$(grep -o '"emergency-bypass:[^"]*"' "$GATES_FILE" 2>/dev/null | tr -d '"')
  auths=$(grep -o '"authorization": *"[^"]*"' "$GATES_FILE" 2>/dev/null | sed 's/.*: *"//; s/"$//')
  printf '%s\n%s\n' "$ids" "$auths" | grep -Fxq -- "$BYPASS_SIG"
}

bypass_rejected() {
  echo "[pre-push] PUSH REJECTED (stage-gate): OPENCLAW_GATE_BYPASS sig does not match any valid emergency-bypass record in $GATES_FILE" >&2
  exit 1
}

# --- main branch gate -------------------------------------------------------
# CX-16: thin shell — the full batch-window audit lives in
# tools/audit-stage-gate.sh (--mode=client), the single source also used by
# the CI repo-surface audit. Byte-equivalent to the pre-CX-16 check_main.
check_main() {
  # locate the script relative to THIS hook (versioned surface), while ROOT
  # stays the data root (throwaway test repos have no tools/ of their own)
  _audit="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/../tools/audit-stage-gate.sh"
  if [ ! -f "$_audit" ]; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for refs/heads/main:" >&2
    echo "  - tools/audit-stage-gate.sh missing (fail-closed)" >&2
    return 1
  fi
  sh "$_audit" --mode=client --local="$1" --remote="$2"
}

# --- version tag gate -------------------------------------------------------
check_tag() {
  tag="$1"
  if [ ! -r "$GATES_FILE" ]; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for $tag: gates.json unreadable at $GATES_FILE (fail-closed)" >&2
    return 1
  fi
  # CX-7: production gates.json is pretty-printed multi-line; flatten to a
  # single stream first so the segment regex is format-independent (the
  # old line-bound grep never matched multi-line files → false rejects).
  # Assumption (schema unchanged): the gate object's metadata is flat, so
  # the first closing brace covers gateId/status/metadata.version.
  flat=$(tr -d '\n' < "$GATES_FILE" 2>/dev/null)
  if [ -z "$flat" ]; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for $tag: gates.json empty/unreadable at $GATES_FILE (fail-closed)" >&2
    return 1
  fi
  seg=$(printf '%s' "$flat" | grep -o '"release-approval-gate"[[:space:]]*:[[:space:]]*{[^}]*}' | head -1)
  if [ -z "$seg" ]; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for $tag: no release-approval-gate record in gates.json" >&2
    return 1
  fi
  if ! printf '%s' "$seg" | grep -q '"status": *"passed"'; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for $tag: release-approval-gate status is not passed" >&2
    return 1
  fi
  gate_ver=$(printf '%s' "$seg" | grep -o '"version": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"$//')
  tag_ver="${tag#v}"
  if [ "$gate_ver" != "$tag_ver" ] && [ "$gate_ver" != "$tag" ]; then
    echo "[pre-push] PUSH REJECTED (stage-gate) for $tag: gates.json version '$gate_ver' != tag '$tag'" >&2
    return 1
  fi
  echo "[pre-push] stage-gate OK: $tag (release-approval-gate passed, version matched)" >&2
  return 0
}

# --- main loop over stdin ref lines ----------------------------------------
if [ -n "$BYPASS_SIG" ]; then
  bypass_is_valid || bypass_rejected
fi

rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  case "$remote_ref" in
    refs/heads/main) kind=main ;;
    refs/tags/v*)    kind=tag ;;
    *) continue ;;
  esac

  if [ -n "$BYPASS_SIG" ]; then
    log_bypass "$remote_ref" "$local_sha"
    echo "[pre-push] BYPASS (valid emergency-bypass sig) for $remote_ref — logged to inbox/govern/bypass-log.md" >&2
    continue
  fi

  # nothing new to push
  if [ "$local_sha" = "$remote_sha" ]; then
    continue
  fi
  # deleting a ref: nothing to validate
  if is_zero_sha "$local_sha"; then
    continue
  fi

  if [ "$kind" = "main" ]; then
    check_main "$local_sha" "$remote_sha" || rc=1
  else
    check_tag "${remote_ref#refs/tags/}" || rc=1
  fi
done

exit $rc
