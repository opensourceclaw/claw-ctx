{
  "name": "@opensourceclaw/claw-ctx",
  "version": "6.7.0",
  "description": "Context Engine for OpenClaw with C2 gating, RL injection, governance, cross-domain, and CI/CD signals — standalone TypeScript plugin",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bin": {
    "claw-ctx": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./pi": "./pi_plugin/index.ts"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc && cp openclaw.plugin.json dist/",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "typedoc": "^0.28.19",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "context-engine"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2"
  }
}
