{
  "name": "@opensourceclaw/claw-ctx",
  "version": "6.15.1",
  "description": "Context Engine for OpenClaw with C2 gating, RL injection, governance, cross-domain, and CI/CD signals — standalone TypeScript plugin",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bin": {
    "claw-ctx": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./pi": "./pi_plugin/index.ts"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc && cp openclaw.plugin.json dist/",
    "lint": "eslint src/",
    "setup": "git config core.hooksPath .githooks || echo '[setup] not a git checkout — core.hooksPath skipped'",
    "postinstall": "npm run setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.4",
    "openclaw": "2026.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "context-engine"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "openclaw": ">=2026.3.28"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": ">=1.31.0",
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "markdown-it": "14.3.3",
    "qs": "6.16.1",
    "undici": "8.12.2",
    "vite": "8.1.6",
    "zod": "4.6.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "openclaw": {
      "minimatch": "11.0.1"
    },
    "typedoc": {
      "minimatch": "11.0.1"
    }
  }
}
