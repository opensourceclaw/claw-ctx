{
  "name": "@opensourceclaw/claw-ctx",
  "version": "4.16.0",
  "description": "Context Engine for OpenClaw with C2 gating, RL injection, governance, cross-domain, and CI/CD signals — standalone TypeScript plugin",
  "main": "dist/index.js",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "tsc && cp openclaw.plugin.json dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "context-engine"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  }
}
