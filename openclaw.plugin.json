{
  "id": "claw-ctx",
  "version": "5.0.0",
  "kind": "context-engine",
  "name": "Claw Context Engine",
  "description": "Standalone Context Engine with claw-mem integration for OpenClaw",
  "configSchema": {
    "type": "object",
    "properties": {
      "workspaceDir": {
        "type": "string"
      },
      "topK": {
        "type": "number",
        "default": 10
      },
      "debug": {
        "type": "boolean",
        "default": false
      },
      "compactThreshold": {
        "type": "number",
        "description": "Compaction trigger threshold (default: 100000)",
        "default": 100000
      },
      "reserveRatio": {
        "type": "number",
        "description": "Safe target ratio (default: 0.7)",
        "default": 0.7
      }
    }
  },
  "activation": {
    "onStartup": true
  }
}