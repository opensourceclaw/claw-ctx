  "inbox": {
    "root": "inbox",
    "directories": {
      "inbox-plan": "Iteration plans, requirements (Friday)",
      "inbox-code": "Development tasks (Friday → Jarvis)",
      "inbox-build": "Build tasks (Jarvis)",
      "inbox-test": "Testing tasks (Friday → Edith)",
      "inbox-release": "Release tasks (Karen+Peter)",
      "inbox-deploy": "Deployment tasks (Karen)",
      "inbox-operate": "Operations tasks (Karen)",
      "inbox-observe": "Observation tasks (Friday)",
      "inbox-govern": "Governance tasks (Friday)",
      "inbox-results": "Completion reports (all agents → Friday)",
      "inbox-friday": "Human-in-the-loop gate / approvals",
      "inbox-code-review": "Code review workspace",
      "inbox-design-review": "Design review workspace",
      "inbox-internal-verify": "Internal pre-release verification",
      "inbox-governance": "Governance events / audit (legacy)"
    },
    "processedDir": "processed"
  },
  "inboxWorkflow": {
    "description": "Agent communication via markdown files in inbox directories",
    "lifecycle": {
      "task_creation": "Friday writes task to inbox-code/ or inbox-test/",
      "task_ack": "Agent writes ack to inbox-results/ when task is picked up",
      "task_execution": "Agent implements tasks following the task file spec",
      "task_complete": "Agent writes completion report to inbox-results/",
      "task_processed": "Friday moves task file from inbox-code/ to inbox-code/processed/ after completion"
    },
    "conventions": {
      "task_files": "Named task-{version}-{descriptor}.md",
      "result_files": "Named {pipelineId}-complete.md or {version}-{phase}-complete.md",
      "stage_tracking": "devclaw.json pipeline.currentStage updated by Friday at each gate",
      "no_polling": "Agents check their read directory on startup and when notified",
      "human_in_loop": "inbox-friday/ for manual approvals; normal flow uses inbox-results/"
    }
  },
  "protocol": {
    "file": "docs/protocol/inbox-protocol.md",
    "version": "v3.6"
  },
  "watcher": {
    "enabled": false,
    "interval": 30000
  },
  "pipeline": {
    "stages": ["PLAN", "CODE", "BUILD", "TEST", "RELEASE", "DEPLOY", "OPERATE", "OBSERVE", "GOVERN"],
